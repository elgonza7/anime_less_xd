# Firebase (Auth + Firestore). Sacalo de Firebase Console > Project Settings > Web App.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# YouTube Data API v3 key (Google Cloud Console > APIs & Services > Credentials).
# Restringila a "YouTube Data API v3" y a tu dominio antes de subir a producción.
VITE_YOUTUBE_API_KEY=
