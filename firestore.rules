rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // datos de episodios: los escribe unicamente el script de GitHub Actions
    // (Admin SDK, que ignora estas reglas). el cliente solo lee, nunca escribe.
    match /episodeRatings/{seriesId} {
      allow read: if true;
      allow write: if false;
    }

    // cache de openings resueltos (anime+opening -> videoId de youtube). se
    // llena solo, la primera vez que alguien juega esa ronda (ver
    // src/services/openingsCacheService.js). publico y sin auth porque jugar
    // no requiere login, y el dato en si no es sensible.
    match /openingsCache/{openingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // leaderboard: para ver el top hay que estar logueado con Google (asi lo
    // pidio el cliente). el puntaje NUNCA se escribe desde el cliente: pasa
    // por api/submit-score.js (Vercel), que valida el token con la Admin SDK,
    // controla "un intento guardado por dia" por usuario y por IP, y recien
    // ahi escribe. asi nadie puede inventarse un totalPoints desde devtools.
    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // igual que arriba: un intento guardado por IP por dia, lo escribe
    // unicamente api/submit-score.js.
    match /dailyIPs/{entryId} {
      allow read, write: if false;
    }
  }
}
