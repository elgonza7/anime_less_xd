rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // datos de episodios: los escribe unicamente el script de GitHub Actions
    // (Admin SDK, que ignora estas reglas). el cliente solo lee, nunca escribe.
    match /episodeRatings/{seriesId} {
      allow read: if true;
      allow write: if false;
    }

    // cache de openings resueltos (anime+opening -> videoId de youtube). se
    // llena solo, la primera vez que alguien juega esa ronda (ver
    // src/services/openingsCacheService.js). publico y sin auth porque jugar
    // no requiere login, y el dato en si no es sensible.
    match /openingsCache/{openingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // leaderboard: para ver el top hay que estar logueado con Google (asi lo
    // pidio el cliente). cada usuario solo puede tocar su propio documento.
    //
    // ojo: esto no evita 100% que alguien logueado mande un totalPoints
    // inventado desde la consola del navegador. para una app de facultad esta
    // bien, pero si esto escala en serio hay que mover la suma de puntos a
    // una Cloud Function callable en vez de escribir directo desde el cliente.
    match /scores/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
